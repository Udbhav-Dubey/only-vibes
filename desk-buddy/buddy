#!/usr/bin/env python3
"""Send events to the local Desk Buddy server."""
import json, os, sys, urllib.request
URL = os.environ.get('BUDDY_URL', 'http://127.0.0.1:3030')

def post(event):
    req = urllib.request.Request(URL + '/event', data=json.dumps(event).encode(),
        headers={'Content-Type':'application/json'}, method='POST')
    try:
        urllib.request.urlopen(req, timeout=2).close()
    except Exception as e:
        print(f'Buddy server unavailable at {URL}: {e}', file=sys.stderr)
        raise SystemExit(1)

if len(sys.argv) < 2:
    raise SystemExit('usage: buddy mode MODE [TEXT] | flash MOOD | dsa [QUESTION] | solved [QUESTION] | build-pass | build-failed | terminal-error | pomo start [focus-min short-min long-min] | pomo skip|stop')
a=sys.argv[1]
if a=='mode': post({'type':'mode','value':sys.argv[2] if len(sys.argv)>2 else 'idle','text':' '.join(sys.argv[3:])})
elif a=='flash': post({'type':'flash','mood':sys.argv[2] if len(sys.argv)>2 else 'happy'})
elif a=='lyric': post({'type':'lyric','line':' '.join(sys.argv[2:])})
elif a=='dsa': post({'type':'dsa_start','text':' '.join(sys.argv[2:]) or "today's problem"})
elif a=='solved': post({'type':'dsa_solved','text':' '.join(sys.argv[2:]) or 'Solved'})
elif a=='build-pass': post({'type':'build_pass'})
elif a=='build-failed': post({'type':'build_failed'})
elif a=='terminal-error': post({'type':'terminal_error'})
elif a in ('pomo','pomodoro') and len(sys.argv)>2:
    action=sys.argv[2]
    if action=='start':
        event={'type':'pomo','action':'start'}
        for key,arg in zip(('focus','short','long'),sys.argv[3:6]): event[key]=float(arg)
        post(event)
    elif action in ('skip','stop'): post({'type':'pomo','action':action})
    else: raise SystemExit('use: buddy pomo start [focus short long] | skip | stop')
else: raise SystemExit('unknown command')
